{
  "id": "/tools/music",
  "name": "QHub Music",
  "short_name": "Music",
  "description": "Локальный музыкальный плеер — MP3, FLAC, WAV и другие форматы",
  "start_url": "/tools/music",
  "scope": "/tools/music",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f9fafb",
  "theme_color": "#111827",
  "lang": "ru",
  "icons": [
    {
      "src": "/tools/music/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/music/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/music/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/tools/music/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/music",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/flac": [".flac"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg"],
        "audio/aac": [".aac"],
        "audio/x-m4a": [".m4a"],
        "audio/x-aiff": [".aiff", ".aif"],
        "audio/opus": [".opus"],
        "audio/webm": [".weba"]
      },
      "launch_type": "single-client",
      "icons": [
        {
          "src": "/tools/music/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        },
        {
          "src": "/tools/music/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing"]
  }
}

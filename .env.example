# OpenAI (recipe finder)
OPENAI_API_KEY=

# Telegram — форма «Предложить идею»
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_IDEAS_TOPIC_ID=
TELEGRAM_DEVELOPERS_TOPIC_ID=6

# Upstash Redis — rate limit для формы идей (upstash.com, бесплатный tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — CAPTCHA на входе в мессенджер (dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Audio Extractor — режим YouTube (по умолчанию client = браузер пользователя)
# client | server (legacy yt-dlp на Vercel)
NEXT_PUBLIC_AUDIO_EXTRACTOR_YOUTUBE_MODE=client
# Опционально: свой Piped/Invidious (client и server fallback)
# NEXT_PUBLIC_PIPED_API_BASE=
# NEXT_PUBLIC_INVIDIOUS_API_BASE=
# YTDLP_COOKIES_B64=  # только для server mode на Vercel

# Admin panel (скрытый URL: /qhub-ctrl-7k2m — не публикуйте)
ADMIN_EMAIL=doping@mail.ru
# Пароль по умолчанию @Lina2019 — меняется в админке; hash хранится в Redis/.data
ADMIN_SESSION_SECRET=
# Messenger auth sessions (обязательно для production)
MESSENGER_SESSION_SECRET=

# Web Push (Family tool) — сгенерируйте: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@qhub.kz

# Native push (FCM) — Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App version sync (Capacitor store builds)
NEXT_PUBLIC_APP_VERSION=0.1.0
APP_MINIMUM_SUPPORTED_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
FLAG_BACKGROUND_LOCATION=true
FLAG_NATIVE_PUSH=true

# Messenger voice calls — Metered.ca TURN (recommended)
# Dashboard → TURN Credentials → Show API Key
# Domain = subdomain before .metered.live (e.g. myapp for myapp.metered.live)
MESSENGER_METERED_DOMAIN=
MESSENGER_METERED_TURN_API_KEY=
# Optional region: global, europe, asia, us_east, etc.
# MESSENGER_METERED_REGION=global

# Alternative: static TURN username/password from Metered dashboard
# MESSENGER_TURN_USERNAME=
# MESSENGER_TURN_CREDENTIAL=
# MESSENGER_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp

# Capacitor — remote UI URL (default https://www.qhub.kz). For LAN dev: http://192.168.x.x:3000
# CAPACITOR_SERVER_URL=https://www.qhub.kz
